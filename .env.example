# OpenRouter API Configuration (chat + Jev decisions)
OPENROUTER_API_KEY=enter_your_api_key_here
# Free model that supports tool calling (llama-3.3-70b-instruct:free is no longer free)
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
# Optional comma-separated fallbacks (max 3) if the primary model is down / rate-limited
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,openrouter/free
JEV_MODEL=~typesafe/jev-latest

# CSUSB Library Primo API Configuration
PRIMO_PUBLIC_BASE=https://csu-sb.primo.exlibrisgroup.com/primaws/rest/pub
PRIMO_VID=01CALS_USB:01CALS_USB
PRIMO_TAB=CSUSB_CSU_Articles
PRIMO_SCOPE=CSUSB_CSU_articles
PRIMO_INST=01CALS_USB
PRIMO_PUBLIC_TIMEOUT=20

# Application Configuration
DATA_DIR=/data
LOG_LEVEL=INFO
